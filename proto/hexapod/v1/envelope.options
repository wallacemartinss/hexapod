# The ESP32 never sees a Position or a PiStatus (hexd -> app only): leaving them out of
# the C union keeps the worst-case serial frame within one COBS block.
hexapod.v1.Envelope.position type:FT_IGNORE
hexapod.v1.Envelope.pi_status type:FT_IGNORE
hexapod.v1.Envelope.targets type:FT_IGNORE
hexapod.v1.Envelope.follow_request type:FT_IGNORE
hexapod.v1.Envelope.follow_status type:FT_IGNORE
hexapod.v1.Envelope.nav_request type:FT_IGNORE
hexapod.v1.Envelope.nav_status type:FT_IGNORE
